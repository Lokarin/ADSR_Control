         ; ------------------------------------------------------------------------------
         ; Main function
         ; ------------------------------------------------------------------------------
          main:
          USART_init:
             ;inicializa a USART (UBRR0 = 103 para 9600 bps)
C:000034 e000          ldi auxReg, high(103)
C:000035 9300 00c5     sts UBRR0H, auxReg
C:000037 e607          ldi auxReg, low(103)
C:000038 9300 00c4     sts UBRR0L, auxReg
         
             ;configura USART: 8 bits, 1 stop, sem paridade
C:00003a e006          ldi auxReg, (1 << UCSZ01) | (1 << UCSZ00)
C:00003b 9300 00c2     sts UCSR0C, auxReg
         
             ;habilita RX
C:00003d e100          ldi auxReg, (1 << RXEN0)
C:00003e 9300 00c1     sts UCSR0B, auxReg
         
          mainLoop:
C:000040 e810          LDI   digiPotSelectorReg, 0b10000000 ;PD7, PD6, PD5, PD4 = habilita o Chip Select dos digipots
C:000041 e054          LDI   opBytesLeft, 0b00000100 ;quando opBytesLeft alcancar 0 o codigo retorna para mainLoop
C:000042 ef0f          LDI   auxReg, 0xFF
         
C:000043 b90a          OUT   DDRD, auxReg ;habilita todas as portas D como saida
C:000044 ef00          LDI   auxReg, 0b11110000 ;
C:000045 b90b          OUT   PORTD, auxReg ;inicia todas as saidas com 0V com excessao de PD7, PD6, PD5, PD4 (Chip Select)
         
C:000046 d040          RCALL recebe4Bytes
C:000047 2d01          MOV   auxReg, opCodeAttackReg ;o byte da fase de attack e carregado primeiro
         
          resistanceDirectionCheck:
             ;verifica se o bit mais a esquerda do opCodeXReg e 0 ou 1
             ;caso bit == 1: upResistanceStart
             ;caso bit == 0: downResistanceStart
         
C:000048 2f60          MOV    UpOrDownReg, auxReg
C:000049 7860          ANDI   UpOrDownReg, 0b10000000
C:00004a 3860          CPI    UpOrDownReg, 0b10000000
C:00004b f009          BREQ   upResistanceStart
C:00004c c015          RJMP   downResistanceStart
         
          upResistanceStart:
             ;decrementa opByterLeft em 1
C:00004d 955a          DEC   opBytesLeft
         
             ;determinar o numero de passos com os 7 outros bits do opCodeXReg
C:00004e 2f70          MOV   totalStepsReg, auxReg
C:00004f 777f          ANDI  totalStepsReg, 0b01111111 ;isolando os 7 bits
C:000050 2f87          MOV   loopReg, totalStepsReg ;valor resultante e armazenado no totalStepsReg
C:000051 3080          CPI   loopReg, 0b00000000 ;se loop = 0, entao pula direto para o proximo opcode
C:000052 f131          BREQ  nextOpCodeContinue
         
             ;habilita o digiPot selecionado em digiPotSelectorReg para aumentar a resistencia
C:000053 e008          LDI   auxReg, 0b00001000 ;PD3(digipots up/down pin) habilita o digipot para comecar em up
C:000054 601f          ORI   digiPotSelectorReg, 0b00001111 ;prepara digiPotSelectorReg para ser invertido(ativo em low)
C:000055 9510          COM   digiPotSelectorReg
C:000056 2b01          OR    auxReg, digiPotSelectorReg
C:000057 b90b          OUT   PORTD, auxReg
C:000058 d04b          RCALL delay500
         
          upResistanceLoop:
             ;ativa e desativa o PD2(digipots CLK) enquanto o numero de steps(ou loops) armazenados em loopReg e != 0
C:000059 7f0b          ANDI   auxReg, 0b11111011 ;borda de subida
C:00005a b90b          OUT   PORTD, auxReg
C:00005b d048          RCALL delay500
         
C:00005c 6004          ORI  auxReg, 0b00000100 ;borda de descida
C:00005d b90b          OUT   PORTD, auxReg
C:00005e d045          RCALL delay500
         
C:00005f 958a          DEC   loopReg
C:000060 f0b1          BREQ  nextOpCode ;se loop foi finalizado pula para o proxima fase do ADSR
         
C:000061 cff7          RJMP  upResistanceLoop ;caso o loop nao tenha acabado retorna para o comeco dele
         
          downResistanceStart:
             ;decrementa a opBytesLeft em 1
C:000062 955a          DEC   opBytesLeft
         
             ;determina o numero de passos(ou loops) com os 7 outros bits do opCodeXReg
C:000063 2f70          MOV   totalStepsReg, auxReg
C:000064 777f          ANDI  totalStepsReg, 0b01111111 ;isolando os 7 bits
C:000065 2f87          MOV   loopReg, totalStepsReg ;valor resultante e armazenado no totalStepsReg
C:000066 3080          CPI   loopReg, 0b00000000 ;se loop = 0, entao pula direto para o proximo opcode
C:000067 f089          BREQ  nextOpCodeContinue
         
             ;habilita o digiPot selecionado em digiPotSelectorReg para diminuir a resistencia
C:000068 e000          LDI   auxReg, 0b00000000 ;PD3(digipots up/down pin) habilita o digipot para comecar em down
C:000069 601f          ORI   digiPotSelectorReg, 0b00001111 ;prepara digiPotSelectorReg para ser invertido(ativo em low)
C:00006a 9510          COM   digiPotSelectorReg
C:00006b 2b01          OR    auxReg, digiPotSelectorReg
C:00006c b90b          OUT   PORTD, auxReg
C:00006d d036          RCALL delay500
         
          downResistanceLoop:
             ;ativa e desativa o PD2(digipots CLK) enquanto o numero de steps(ou loops) armazenados em loopReg e != 0
C:00006e 7f0b          ANDI   auxReg, 0b11111011 ;borda de subida
C:00006f b90b          OUT   PORTD, auxReg
C:000070 d033          RCALL delay500
         
C:000071 6004          ORI  auxReg, 0b00000100 ;borda de descida
C:000072 b90b          OUT   PORTD, auxReg
C:000073 d030          RCALL delay500
         
C:000074 958a          DEC   loopReg
C:000075 f009          BREQ  nextOpCode ;se loop foi finalizado pula para o proxima fase do ADSR
         
C:000076 cff7          RJMP  downResistanceLoop ;caso o loop nao tenha acabado retorna para o comeco dele
         
          nextOpCode:
             ;restaura digiPotSelectorReg para a forma binaria original
C:000077 601f          ORI   digiPotSelectorReg, 0b00001111
C:000078 9510          COM   digiPotSelectorReg
         
          nextOpCodeContinue:
             ;ativa o proximo digipot
C:000079 9516          LSR   digiPotSelectorReg
         
             ;se opBytesLeft == 0 jump para "fim" label
C:00007a 3050          CPI   opBytesLeft, 0b00000000
C:00007b f051          BREQ  fim
         
             ;se opBytesLeft == 3 jump para opCodeHoldReg label
C:00007c 3053          CPI   opBytesLeft, 0b00000011
C:00007d f021          BREQ  opCodeHold
         
             ;se opBytesLeft == 2 jump para opCodeSustain label
             ;se opBytesLeft != 2 codigo continua
C:00007e 3052          CPI   opBytesLeft, 0b00000010
C:00007f f021          BREQ  opCodeSustain
         
          opCodeDecayAndRelease:
             ;carrega opCodeDecayAndReleaseReg para auxReg e reinicia o codigo em resistanceDirectionCheck
C:000080 2d03          MOV   auxReg, opCodeDecayAndReleaseReg
C:000081 cfc6          RJMP  resistanceDirectionCheck
         
          opCodeHold:
             ;carrega opCodeSustainReg para auxReg e reinicia o codigo em resistanceDirectionCheck
C:000082 2d02          MOV   auxReg, opCodeHoldReg
C:000083 cfc4          RJMP  resistanceDirectionCheck
         
          opCodeSustain:
             ;carrega opCodeSustainReg para auxReg e reinicia o codigo em resistanceDirectionCheck
C:000084 2d04          MOV   auxReg, opCodeSustainReg
C:000085 cfc2          RJMP  resistanceDirectionCheck
         
          fim:
C:000086 cfb9          RJMP  mainLoop
         
         ; =================================================
         ; Sub-rotina: espera e le 4 bytes da interface USART
         ; =================================================
          recebe4Bytes:
             ; Byte 1
          recebeByte1:
C:000087 9100 00c0     LDS  auxReg, UCSR0A
C:000089 ff07          SBRS auxReg, RXC0
C:00008a cffc          RJMP recebeByte1
         
C:00008b 9000 00c6     LDS  byteRecebido, UDR0
C:00008d 2c10          MOV  opCodeAttackReg, byteRecebido
         
             ; Byte 2
          recebeByte2:
C:00008e 9100 00c0     LDS  auxReg, UCSR0A
C:000090 ff07          SBRS auxReg, RXC0
C:000091 cffc          RJMP recebeByte2
         
C:000092 9000 00c6     LDS  byteRecebido, UDR0
C:000094 2c20          MOV  opCodeHoldReg, byteRecebido
         
             ; Byte 3
          recebeByte3:
C:000095 9100 00c0     LDS  auxReg, UCSR0A
C:000097 ff07          SBRS auxReg, RXC0
C:000098 cffc          RJMP recebeByte3
         
C:000099 9000 00c6     LDS  byteRecebido, UDR0
C:00009b 2c40          MOV  opCodeSustainReg, byteRecebido
         
             ; Byte 4
          recebeByte4:
C:00009c 9100 00c0     LDS  auxReg, UCSR0A
C:00009e ff07          SBRS auxReg, RXC0
C:00009f cffc          RJMP recebeByte4
         
C:0000a0 9000 00c6     LDS  byteRecebido, UDR0
C:0000a2 2c30          MOV  opCodeDecayAndReleaseReg, byteRecebido
         
C:0000a3 9508          RET
         
