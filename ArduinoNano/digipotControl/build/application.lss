         ; ***** END OF FILE ******************************************************
          ; ***** END OF FILE ******************************************************
         
         ; ------------------------------------------------------------------------------
         ; Register definitions
         ; ------------------------------------------------------------------------------
          .def    digiPotSelectorReg          = R17
          .def    auxReg                      = R16
          .def    opBytesLeft                 = R21
          .def    UpOrDownReg                 = R22
          .def    totalStepsReg               = R23
          .def    loopReg                     = R24
          .def    byteRecebido                = R0
          .def    opCodeAttackReg             = R1
          .def    opCodeHoldReg               = R2
          .def    opCodeDecayAndReleaseReg    = R3
          .def    opCodeSustainReg            = R4
         
         ; ------------------------------------------------------------------------------
         ; Interrupt vectors
         ; ------------------------------------------------------------------------------
          .org 0x0000
C:000000 940c 00b1     JMP resetHandler
          .org INT0addr
C:000002 940c 00b0     JMP int0Handler
          .org INT1addr
C:000004 940c 00b0     JMP int1Handler
          .org PCI0addr
C:000006 940c 00b0     JMP pcint0Handler
          .org PCI1addr
C:000008 940c 00b0     JMP pcint1Handler
          .org PCI2addr
C:00000a 940c 00b0     JMP pcint2Handler
          .org WDTaddr
C:00000c 940c 00b0     JMP wdtHandler
          .org OC2Aaddr
